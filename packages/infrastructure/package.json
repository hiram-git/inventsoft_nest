{
  "name": "@inventsoft/infrastructure",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "db:generate":    "dotenv -e ../../apps/api/.env -- prisma generate --schema=./src/prisma/schema.prisma",
    "db:migrate":     "dotenv -e ../../apps/api/.env -- prisma migrate dev --schema=./src/prisma/schema.prisma",
    "db:migrate:prod":"dotenv -e ../../apps/api/.env -- prisma migrate deploy --schema=./src/prisma/schema.prisma",
    "db:studio":      "dotenv -e ../../apps/api/.env -- prisma studio --schema=./src/prisma/schema.prisma",
    "db:push":        "dotenv -e ../../apps/api/.env -- prisma db push --schema=./src/prisma/schema.prisma",
    "db:reset":       "dotenv -e ../../apps/api/.env -- prisma migrate reset --schema=./src/prisma/schema.prisma"
  },
  "dependencies": {
    "@inventsoft/domain": "workspace:*",
    "@nestjs/common": "10.4.15",
    "@prisma/client": "5.22.0",
    "bullmq": "5.34.6",
    "ioredis": "5.4.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@types/node": "20.17.10",
    "dotenv-cli": "7.4.4",
    "prisma": "5.22.0",
    "typescript": "5.7.3"
  }
}
