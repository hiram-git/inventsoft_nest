generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Inventory Context ────────────────────────────────────────────────────────

model Product {
  id          String   @id @default(cuid())
  sku         String   @unique
  name        String
  description String   @default("")
  unitCost    Decimal  @db.Decimal(12, 4)
  unitPrice   Decimal  @db.Decimal(12, 4) @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stockItems         StockItem[]
  stockMovements     StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  saleOrderItems     SaleOrderItem[]

  @@map("products")
}

model Warehouse {
  id          String   @id @default(cuid())
  name        String
  location    String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stockItems     StockItem[]
  stockMovements StockMovement[]

  @@map("warehouses")
}

// Stock actual por producto + almacén (con version para optimistic locking)
model StockItem {
  id          String   @id @default(cuid())
  productId   String
  warehouseId String
  quantity    Int      @default(0)
  version     Int      @default(0)
  updatedAt   DateTime @updatedAt

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
  @@map("stock_items")
}

// Log inmutable de todos los movimientos de inventario
model StockMovement {
  id          String            @id @default(cuid())
  type        StockMovementType
  productId   String
  warehouseId String
  quantity    Int               // Siempre positivo
  reference   String?           // purchaseOrderId, saleOrderId, etc.
  notes       String?
  createdBy   String?           // Clerk userId
  createdAt   DateTime          @default(now())

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([productId])
  @@index([warehouseId])
  @@index([type])
  @@index([createdAt])
  @@map("stock_movements")
}

enum StockMovementType {
  IN          // Recepción / ingreso
  OUT         // Salida
  ADJUSTMENT  // Ajuste manual
}

// ─── Purchases Context ────────────────────────────────────────────────────────

model Supplier {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  supplierId  String
  status      PurchaseOrderStatus @default(DRAFT)
  totalAmount Decimal             @db.Decimal(14, 4)
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]

  @@index([supplierId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Int
  unitCost        Decimal       @db.Decimal(12, 4)
  createdAt       DateTime      @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RECEIVED
  CANCELLED
}

// ─── Sales Context ────────────────────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  saleOrders SaleOrder[]

  @@map("customers")
}

model SaleOrder {
  id          String          @id @default(cuid())
  customerId  String
  status      SaleOrderStatus @default(DRAFT)
  totalAmount Decimal         @db.Decimal(14, 4)
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  customer Customer       @relation(fields: [customerId], references: [id])
  items    SaleOrderItem[]

  @@index([customerId])
  @@index([status])
  @@map("sale_orders")
}

model SaleOrderItem {
  id          String   @id @default(cuid())
  saleOrderId String
  productId   String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 4)
  createdAt   DateTime @default(now())

  saleOrder SaleOrder @relation(fields: [saleOrderId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@index([saleOrderId])
  @@map("sale_order_items")
}

enum SaleOrderStatus {
  DRAFT
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}
