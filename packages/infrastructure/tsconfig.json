{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "composite": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@inventsoft/domain": ["../domain/src/index.ts"],
      "@inventsoft/shared": ["../shared/src/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
